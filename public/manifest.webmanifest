{
  "id": "/",
  "name": "ScrapSheet",
  "short_name": "ScrapSheet",
  "description": "Notes, files and photos on every device, end-to-end encrypted.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#f5f1eb",
  "theme_color": "#f5f1eb",
  "icons": [
    {
      "src": "/assets/icon-192.png?v=3",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icon-512.png?v=3",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icon-maskable-512.png?v=3",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "scope": "/",
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "*/*"
          ]
        }
      ]
    }
  }
}
